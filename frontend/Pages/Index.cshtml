@page
@model IndexModel
@{
    ViewData["Title"] = "Doorstep Massage Service Centre | RelaxAtHome";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-badge">
                    <i class="fa-solid fa-certificate"></i>
                    <span data-en="Premier Certified Doorstep Massage Service" 
                          data-ta="சான்றளிக்கப்பட்ட இல்ல மசாஜ் சேவை மையம்">
                        Premier Certified Doorstep Massage Service
                    </span>
                </div>

                <h1 class="hero-title">
                    <span data-en="5-Star Luxury Spa Massage," data-ta="5-நட்சத்திர சொகுசு ஸ்பா மசாஜ்,">5-Star Luxury Spa Massage,</span><br />
                    <span class="hero-highlight" data-en="Delivered to Your Doorstep." data-ta="உங்கள் இல்லத்திற்கே வருகிறது.">Delivered to Your Doorstep.</span>
                </h1>

                <p class="hero-desc" 
                   data-en="Experience deep physical healing and ultimate calm without leaving your home. Our certified therapists arrive equipped with a sanitized portable spa bed, fresh linens, and pure organic essential oils."
                   data-ta="உங்கள் வீட்டை விட்டு வெளியேறாமல் உடலுக்கும் மனதிற்கும் ஆழ்ந்த அமைதி பெறுங்கள். எங்கள் சான்றளிக்கப்பட்ட நிபுணர்கள் சுத்திகரிக்கப்பட்ட மசாஜ் படுக்கை மற்றும் இயற்கை எண்ணெய்களுடன் உங்கள் வாசலில் ஆஜராவர்.">
                    Experience deep physical healing and ultimate calm without leaving your home. Our certified therapists arrive equipped with a sanitized portable spa bed, fresh linens, and pure organic essential oils.
                </p>

                <div class="hero-cta-group">
                    <button type="button" 
                            class="btn-primary-spa" 
                            onclick="openBookingModal('deep-tissue', 'Deep Tissue Muscle Relief Massage', 'ஆழ்ந்த தசை வலி நிவாரண மசாஜ்', 1799, 60, '[{&quot;minutes&quot;:60,&quot;price&quot;:1799},{&quot;minutes&quot;:90,&quot;price&quot;:2399},{&quot;minutes&quot;:120,&quot;price&quot;:3099}]')">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span data-en="Book Doorstep Massage" data-ta="இல்ல மசாஜ் முன்பதிவு">Book Doorstep Massage</span>
                    </button>

                    <a href="https://wa.me/@Model.WhatsAppPhone?text=Hello!%20I%20want%20to%20book%20a%20doorstep%20massage%20service" 
                       target="_blank" 
                       class="btn-whatsapp-big">
                        <i class="fa-brands fa-whatsapp fs-5"></i>
                        <span data-en="Instant WhatsApp Booking" data-ta="உடனடி வாட்ஸ்அப் முன்பதிவு">Instant WhatsApp Booking</span>
                    </a>
                </div>

                <div class="hero-stats-row">
                    <div class="hero-stat-item">
                        <div class="stat-icon"><i class="fa-solid fa-star text-warning"></i></div>
                        <div class="stat-text">
                            <strong>4.9 / 5.0</strong>
                            <span data-en="12,500+ Happy Clients" data-ta="12,500+ வாடிக்கையாளர்கள்">12,500+ Happy Clients</span>
                        </div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="stat-icon"><i class="fa-solid fa-user-shield"></i></div>
                        <div class="stat-text">
                            <strong data-en="100% Verified" data-ta="100% சரிபார்க்கப்பட்டது">100% Verified</strong>
                            <span data-en="Certified Therapists" data-ta="சான்றளிக்கப்பட்ட நிபுணர்கள்">Certified Therapists</span>
                        </div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="stat-icon"><i class="fa-solid fa-pump-medical"></i></div>
                        <div class="stat-text">
                            <strong data-en="Sanitized Setup" data-ta="சுத்திகரிக்கப்பட்ட படுக்கை">Sanitized Setup</strong>
                            <span data-en="Beds & Fresh Linens" data-ta="புதிய துண்டுகள்">Beds & Fresh Linens</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Visual Showcase Card -->
            <div class="col-lg-5">
                <div class="hero-visual-card">
                    <div class="visual-card-banner">
                        <span class="visual-banner-badge" data-en="At-Home Sanctuary" data-ta="இல்ல அமைதி">At-Home Sanctuary</span>
                        <h4 class="mb-1 text-white font-serif" data-en="Therapist At Your Door" data-ta="உங்கள் வாசலில் நிபுணர்">Therapist At Your Door</h4>
                        <p class="small text-white-50 mb-0" data-en="We bring the complete spa ambience to your living space" data-ta="முழு ஸ்பா வசதியையும் உங்கள் வீட்டிற்கே கொண்டு வருகிறோம்">
                            We bring the complete spa ambience to your living space
                        </p>
                    </div>

                    <div class="doorstep-features-pill-grid">
                        <div class="doorstep-feature-pill">
                            <i class="fa-solid fa-bed"></i>
                            <span data-en="Portable Spa Bed" data-ta="மடக்கும் ஸ்பா படுக்கை">Portable Spa Bed</span>
                        </div>
                        <div class="doorstep-feature-pill">
                            <i class="fa-solid fa-leaf"></i>
                            <span data-en="Herbal Organic Oils" data-ta="மூலிகை நறுமண எண்ணெய்கள்">Herbal Organic Oils</span>
                        </div>
                        <div class="doorstep-feature-pill">
                            <i class="fa-solid fa-users"></i>
                            <span data-en="Male & Female Therapists" data-ta="ஆண் / பெண் நிபுணர்கள்">Male & Female Therapists</span>
                        </div>
                        <div class="doorstep-feature-pill">
                            <i class="fa-solid fa-shield-virus"></i>
                            <span data-en="Hospital Grade Hygiene" data-ta="உயர்தர சுகாதாரம்">Hospital Grade Hygiene</span>
                        </div>
                    </div>

                    <div class="mt-3 p-3 bg-light rounded text-center border">
                        <small class="text-muted d-block mb-1" data-en="Need assistance right now?" data-ta="உடனடி உதவி தேவையா?">Need assistance right now?</small>
                        <a href="https://wa.me/@Model.WhatsAppPhone?text=Hello!%20I%20have%20a%20question%20about%20your%20services" 
                           target="_blank" 
                           class="text-success fw-bold text-decoration-none">
                            <i class="fa-brands fa-whatsapp me-1"></i>
                            <span data-en="Chat directly on WhatsApp (+91 98765 43210)" data-ta="வாட்ஸ்அப்பில் உரையாடவும் (+91 98765 43210)">Chat directly on WhatsApp (+91 98765 43210)</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES CATALOG SECTION -->
<section class="services-section" id="services">
    <div class="container">
        <div class="section-header">
            <span class="section-badge" data-en="Therapeutic Treatments" data-ta="சிகிச்சை மசாஜ்கள்">Therapeutic Treatments</span>
            <h2 class="section-title" data-en="Doorstep Massage Services" data-ta="எங்கள் இல்ல மசாஜ் சேவைகள்">Doorstep Massage Services</h2>
            <p class="section-subtitle" 
               data-en="Tailored treatments designed for muscular tension relief, stress unwinding, and cellular detoxification in your home."
               data-ta="தசை வலி நிவாரணம், மன அமைதி மற்றும் உடல் புத்துணர்ச்சிக்காக வடிவமைக்கப்பட்ட சிறப்பு சேவைகள்.">
                Tailored treatments designed for muscular tension relief, stress unwinding, and cellular detoxification in your home.
            </p>
        </div>

        <div class="services-grid">
            @foreach (var s in Model.Services)
            {
                var defaultDuration = s.Durations.FirstOrDefault() ?? new ServiceDuration { Minutes = 60, Price = 1799, OriginalPrice = 2299 };
                var durationsJson = System.Text.Json.JsonSerializer.Serialize(s.Durations);

                <div class="service-card @(s.Popular ? "popular-service" : "")">
                    @if (s.Popular)
                    {
                        <div class="popular-ribbon" data-en="Most Popular" data-ta="அதிகம் விரும்பப்படுவது">Most Popular</div>
                    }

                    <div class="service-card-header">
                        <div class="service-icon-box">
                            <i class="@s.Icon"></i>
                        </div>
                        <div>
                            <span class="badge bg-light text-success border mb-1" 
                                  data-en="@s.CategoryEn" 
                                  data-ta="@s.CategoryTa">@s.CategoryEn</span>
                            <h3 class="service-title" 
                                data-en="@s.NameEn" 
                                data-ta="@s.NameTa">@s.NameEn</h3>
                        </div>
                    </div>

                    <div class="service-card-body">
                        <div class="service-tagline" 
                             data-en="@s.TaglineEn" 
                             data-ta="@s.TaglineTa">@s.TaglineEn</div>
                        <p class="service-desc" 
                           data-en="@s.DescriptionEn" 
                           data-ta="@s.DescriptionTa">@s.DescriptionEn</p>

                        <div class="service-meta-info">
                            <div class="mb-1">
                                <i class="fa-solid fa-oil-can"></i>
                                <strong data-en="Oil:" data-ta="எண்ணெய்:">Oil:</strong>
                                <span data-en="@s.OilsEn" data-ta="@s.OilsTa">@s.OilsEn</span>
                            </div>
                            <div>
                                <i class="fa-solid fa-user-nurse"></i>
                                <strong data-en="Therapist:" data-ta="நிபுணர்:">Therapist:</strong>
                                <span data-en="Male / Female Available" data-ta="ஆண் / பெண் நிபுணர்கள் உள்ளனர்">Male / Female Available</span>
                            </div>
                        </div>

                        <!-- Duration Selector Chips -->
                        <div class="durations-selector">
                            @for (int i = 0; i < s.Durations.Count; i++)
                            {
                                var d = s.Durations[i];
                                <div class="duration-chip @(i == 0 ? "selected" : "")" 
                                     data-minutes="@d.Minutes" 
                                     data-price="@d.Price">
                                    <span class="time">@d.Minutes <span data-en="Mins" data-ta="நிமி">Mins</span></span>
                                    <span class="price">₹@d.Price</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="service-card-footer">
                        <button type="button" 
                                class="btn-card-book" 
                                onclick='openBookingModal("@s.Id", "@Html.Raw(s.NameEn.Replace("\"", "\\\""))", "@Html.Raw(s.NameTa.Replace("\"", "\\\""))", @defaultDuration.Price, @defaultDuration.Minutes, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(durationsJson)))'>
                            <i class="fa-solid fa-calendar-plus"></i>
                            <span data-en="Book Doorstep" data-ta="முன்பதிவு">Book Doorstep</span>
                        </button>

                        <button type="button" 
                                class="btn-card-wa" 
                                onclick='openQuickServiceWhatsApp("@Html.Raw(s.NameEn.Replace("\"", "\\\""))", "@Html.Raw(s.NameTa.Replace("\"", "\\\""))")'>
                            <i class="fa-brands fa-whatsapp"></i>
                            <span data-en="WhatsApp" data-ta="வாட்ஸ்அப்">WhatsApp</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- HOW DOORSTEP MASSAGE WORKS -->
<section class="how-it-works-section" id="how-it-works">
    <div class="container">
        <div class="section-header">
            <span class="section-badge" data-en="Simple & Seamless" data-ta="எளிதான முறை">Simple & Seamless</span>
            <h2 class="section-title" data-en="How Doorstep Massage Works" data-ta="இல்ல மசாஜ் எப்படி செயல்படுகிறது">How Doorstep Massage Works</h2>
            <p class="section-subtitle" 
               data-en="Four simple steps to turn your home into a private tranquil sanctuary."
               data-ta="உங்கள் வீட்டை ஒரு அமைதியான ஸ்பாவாக மாற்ற 4 எளிய வழிகள்.">
                Four simple steps to turn your home into a private tranquil sanctuary.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h4 class="step-title" data-en="Choose Treatment & Slot" data-ta="மசாஜ் & நேரம் தேர்வு">Choose Treatment & Slot</h4>
                    <p class="step-desc" 
                       data-en="Select your preferred massage, duration, therapist gender preference, and time slot via website or WhatsApp."
                       data-ta="உங்களுக்கு பிடித்த மசாஜ், கால அளவு, நிபுணர் விருப்பம் மற்றும் நேரத்தை ஆன்லைன் அல்லது வாட்ஸ்அப்பில் தேர்வு செய்யவும்.">
                        Select your preferred massage, duration, therapist gender preference, and time slot via website or WhatsApp.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h4 class="step-title" data-en="Therapist Arrives At Home" data-ta="நிபுணர் வருகை">Therapist Arrives At Home</h4>
                    <p class="step-desc" 
                       data-en="Our verified therapist arrives promptly with a professional foldable massage bed, fresh linens, and organic oils."
                       data-ta="எங்கள் சான்றளிக்கப்பட்ட நிபுணர் மசாஜ் படுக்கை, புதிய துண்டுகள் மற்றும் நறுமண எண்ணெய்களுடன் உங்கள் வீட்டிற்கு வருவார்.">
                        Our verified therapist arrives promptly with a professional foldable massage bed, fresh linens, and organic oils.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h4 class="step-title" data-en="Quick 5-Min Spa Setup" data-ta="5 நிமிட அமைவு">Quick 5-Min Spa Setup</h4>
                    <p class="step-desc" 
                       data-en="The therapist quickly sets up the spa bed in your bedroom or living area with soothing aroma and relaxing background music."
                       data-ta="உங்கள் அறையிலேயே படுக்கை அமைக்கப்பட்டு, நறுமணம் மற்றும் மென்மையான இசையுடன் ஸ்பா சூழல் உருவாக்கப்படும்.">
                        The therapist quickly sets up the spa bed in your bedroom or living area with soothing aroma and relaxing background music.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="step-card">
                    <div class="step-number">4</div>
                    <h4 class="step-title" data-en="Blissful Relaxation" data-ta="முழுமையான இளைப்பாறல்">Blissful Relaxation</h4>
                    <p class="step-desc" 
                       data-en="Enjoy an uncompromising therapeutic session. Once finished, therapist packs everything cleanly. Pay via UPI or cash."
                       data-ta="அமைதியான மசாஜ் அனுபவத்தை அனுபவியுங்கள். முடிந்ததும் அனைத்தும் சுத்தமாக எடுத்துக்கொள்ளப்படும். UPI அல்லது ரொக்கமாக செலுத்தலாம்.">
                        Enjoy an uncompromising therapeutic session. Once finished, therapist packs everything cleanly. Pay via UPI or cash.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HYGIENE & SAFETY PROMISE -->
<section class="hygiene-section" id="hygiene">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="text-warning fw-bold text-uppercase" style="letter-spacing:1.5px;" data-en="Uncompromising Standards" data-ta="உயர்தர பாதுகாப்பு">Uncompromising Standards</span>
                <h2 class="display-6 fw-bold mt-2 text-white font-serif" 
                    data-en="Our Doorstep Hygiene & Safety Guarantee" 
                    data-ta="எங்கள் சுகாதாரம் மற்றும் பாதுகாப்பு உத்தரவாதம்">
                    Our Doorstep Hygiene & Safety Guarantee
                </h2>
                <p class="text-white-50 mt-3" 
                   data-en="Your privacy, comfort, and well-being are sacred to us. Every therapist is background-verified, medically certified, and adheres to strict clinical hygiene protocols."
                   data-ta="உங்கள் தனியுரிமை, சௌகரியம் மற்றும் நல்வாழ்வு எங்களுக்கு மிக முக்கியம். ஒவ்வொரு நிபுணரும் பின்னணி சரிபார்க்கப்பட்டவர்கள் மற்றும் கடுமையான சுகாதார முறைகளைப் பின்பற்றுபவர்கள்.">
                    Your privacy, comfort, and well-being are sacred to us. Every therapist is background-verified, medically certified, and adheres to strict clinical hygiene protocols.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="hygiene-grid">
                    <div class="hygiene-item">
                        <div class="hygiene-icon"><i class="fa-solid fa-id-card-clip"></i></div>
                        <h4 data-en="Police Verified Therapists" data-ta="சரிபார்க்கப்பட்ட நிபுணர்கள்">Police Verified Therapists</h4>
                        <p data-en="Certified experts with verified identities and professional spa credentials." data-ta="அடையாள அட்டை மற்றும் சான்றிதழ் கொண்ட தொழில்முறை நிபுணர்கள்.">Certified experts with verified identities.</p>
                    </div>

                    <div class="hygiene-item">
                        <div class="hygiene-icon"><i class="fa-solid fa-pump-medical"></i></div>
                        <h4 data-en="Sanitized Equipment" data-ta="சுத்திகரிக்கப்பட்ட உபகரணங்கள்">Sanitized Equipment</h4>
                        <p data-en="Spa bed sanitized before & after every visit with medical-grade disinfectant." data-ta="ஒவ்வொரு சேவைக்கு முன்பும் பின்பும் படுக்கை முழுமையாக கிருமி நீக்கம் செய்யப்படுகிறது.">Spa bed sanitized before & after every visit.</p>
                    </div>

                    <div class="hygiene-item">
                        <div class="hygiene-icon"><i class="fa-solid fa-hands-bubbles"></i></div>
                        <h4 data-en="Disposable Linens & Towels" data-ta="ஒருமுறை பயன்படுத்தும் விரிப்புகள்">Disposable Linens & Towels</h4>
                        <p data-en="Single-use disposable sheets, face cradle covers, and fresh autoclaved towels." data-ta="புதிய ஒருமுறை பயன்படுத்தும் படுக்கை விரிப்புகள் மற்றும் சுத்தமான துண்டுகள்.">Single-use sheets and fresh towels.</p>
                    </div>

                    <div class="hygiene-item">
                        <div class="hygiene-icon"><i class="fa-solid fa-bottle-droplet"></i></div>
                        <h4 data-en="100% Organic Oils" data-ta="இயற்கை மூலிகை எண்ணெய்கள்">100% Organic Oils</h4>
                        <p data-en="Cold-pressed sesame, almond, and essential oils free of mineral oils or parabens." data-ta="ரசாயனம் இல்லாத தூய மரச்செக்கு மற்றும் மூலிகை எண்ணெய்கள்.">Cold-pressed pure essential oils.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS SECTION -->
<section class="testimonials-section" id="reviews">
    <div class="container">
