    // --- LOCATIONS LOGIC ---
    function addNewLocationRow() {
        const container = document.getElementById('locationsListContainer');
        const div = document.createElement('div');
        div.className = 'row g-2 mb-2 location-row align-items-center';
        div.innerHTML = `
            <div class="col-md-4">
                <input type="text" class="form-control loc-city" placeholder="City Name" required />
            </div>
            <div class="col-md-7">
                <input type="text" class="form-control loc-areas" placeholder="Covered Areas (e.g. Adyar, OMR)" required />
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" onclick="this.closest('.location-row').remove()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        `;
        container.appendChild(div);
    }

    async function saveLocations(e) {
        e.preventDefault();
        const rows = document.querySelectorAll('.location-row');
        const locations = [];
        rows.forEach(r => {
            const city = r.querySelector('.loc-city').value.trim();
            const areas = r.querySelector('.loc-areas').value.trim();
            if (city) {
                locations.push({ city, areas });
            }
        });

        const payload = {
            serviceCities: document.getElementById('cfgServiceCities').value.trim(),
            serviceCitiesTa: document.getElementById('cfgServiceCitiesTa').value.trim(),
            locations: locations
        };

        const btn = document.getElementById('btnSaveLocations');
        btn.disabled = true;

        try {
            const resp = await fetch(`${API_URL}/admin/config`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (resp.ok) {
                showAdminAlert('Service locations & zones updated live!');
            } else {
                showAdminAlert('Failed to save locations', true);
            }
        } catch (err) {
            showAdminAlert('Error: ' + err.message, true);
        } finally {
            btn.disabled = false;
        }
    }

