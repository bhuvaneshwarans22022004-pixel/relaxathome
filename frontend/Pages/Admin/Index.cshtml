    // --- RESET DEFAULTS ---
    async function resetToDefaults() {
        if (!confirm('Are you sure you want to reset all service cards, prices, and settings to original defaults?')) {
            return;
        }

        try {
            const resp = await fetch(`${API_URL}/admin/reset`, { method: 'POST' });
            if (resp.ok) {
                showAdminAlert('Restored default services and settings. Reloading...');
                setTimeout(() => location.reload(), 1000);
            } else {
                showAdminAlert('Reset failed', true);
            }
        } catch (err) {
            showAdminAlert('Error: ' + err.message, true);
        }
    }
